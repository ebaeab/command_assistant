{
  "name": "ink-command-app",
  "version": "1.0.0",
  "description": "Terminal app for command execution with Ink",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ink-term": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "package": "npm run build && chmod +x dist/index.js"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
